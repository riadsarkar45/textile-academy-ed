// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id       Int    @id @default(autoincrement())
  name     String
  username String
  email    String
  password String
}

model mcqQuestions {
  id        Int      @id @default(autoincrement())
  question  String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  subjectId      Int?
  questionYearId Int?

  options      mcqOptions[]
  subjects     subjects?     @relation(fields: [subjectId], references: [id])
  questionYear questionYear? @relation(fields: [questionYearId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@map("mcq_questions")
}

model questionYear {
  id           Int            @id @default(autoincrement())
  examTitle    String         @db.VarChar(100)
  subjectId    Int
  year         String         @db.VarChar(4)
  mcqQuestions mcqQuestions[]
}

model mcqOptions {
  id         Int          @id @default(autoincrement())
  options    String       @db.VarChar(500)
  isCorrect  Boolean      @default(false)
  questionId Int
  question   mcqQuestions @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("mcq_options")
}

model examAttempts {
  id          Int             @id @default(autoincrement())
  userId      Int
  correctAns  Int?
  wrongAns    Int?
  subjectId   Int
  takenAt     DateTime        @default(now())
  submissions mcqSubmission[]
}

model mcqSubmission {
  id          Int          @id @default(autoincrement())
  questionId  String
  optionId    Int
  isCorrect   Boolean
  userId      Int
  attemptId   Int
  examAttempt examAttempts @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model subjects {
  id           Int            @id @default(autoincrement())
  subjectName  String         @unique @db.VarChar(100)
  mcqQuestions mcqQuestions[]

  @@map("subjects")
}

model communityPosts {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  content   String   @db.Text
  authorId  Int
  createdAt DateTime @default(now())

  @@map("community_posts")
}
