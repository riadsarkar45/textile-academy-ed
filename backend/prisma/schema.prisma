// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id       Int    @id @default(autoincrement())
  name     String
  username String
  email    String @unique
  role     String
  password String

  examAttempt examAttempts[]
}

model mcqQuestions {
  id             Int      @id @default(autoincrement())
  question       String   @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  tempKey        String   @unique
  examType       String
  examTopicId    Int
  subjectId      Int
  questionYearId Int?

  options      mcqOptions[]
  subjects     subjects?     @relation(fields: [subjectId], references: [id])
  questionYear questionYear? @relation(fields: [questionYearId], references: [id], onDelete: Cascade)
  topics       topics        @relation(fields: [examTopicId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@map("mcq_questions")
}

model topics {
  id         Int    @id @default(autoincrement())
  topicTitle String
  subjectId  Int

  questions mcqQuestions[]
  subjects  subjects?      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model questionYear {
  id           Int            @id @default(autoincrement())
  examTitle    String         @db.VarChar(100)
  subjectId    Int
  year         Int
  mcqQuestions mcqQuestions[]
}

model mcqOptions {
  id         Int          @id @default(autoincrement())
  options    String       @db.VarChar(500)
  isCorrect  Boolean      @default(false)
  questionId Int
  question   mcqQuestions @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("mcq_options")
}

model examAttempts {
  id          Int             @id @default(autoincrement())
  userId      Int
  correctAns  Int?
  wrongAns    Int?
  subjectId   Int
  takenAt     DateTime        @default(now())
  user        users           @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions mcqSubmission[]
  subjects    subjects?       @relation(fields: [subjectId], references: [id])
}

model mcqSubmission {
  id          Int          @id @default(autoincrement())
  questionId  String
  optionId    Int
  isCorrect   Boolean
  userId      Int
  attemptId   Int
  examAttempt examAttempts @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model subjects {
  id           Int            @id @default(autoincrement())
  subjectName  String         @unique @db.VarChar(100)
  examType     String
  mcqQuestions mcqQuestions[]
  topics       topics[]
  examAttempt  examAttempts[]

  @@map("subjects")
}

model communityPosts {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  content   String   @db.Text
  authorId  Int
  createdAt DateTime @default(now())

  @@map("community_posts")
}
